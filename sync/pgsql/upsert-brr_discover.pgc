/*
 *  Synopsis:
 *	Upsert the oldest time of a blob was seen in a brr record.
 *  Exit Codes:
 *	0	tuple upserted ok
 *	1	unexpected error
 */
#include <fcntl.h>
#include <stdlib.h>
#include <unistd.h>

#include <stdio.h>

#include "jmscott/libjmscott.h"

#define EXIT_EXISTS		0
#define EXIT_BAD		1

char *jmscott_progname = "upsert-brr_discover";
static char *usage = "upsert-brr_discover <udig> <start_time>"
;

extern int jmscott_ecpg_error_code;
extern int jmscott_ecpg_warn_code;

static void
die(char *msg)
{
        jmscott_die(EXIT_BAD, msg);
}

static void
die2(char *msg1, char *msg2)
{
        jmscott_die2(EXIT_BAD, msg1, msg2);
}

int
main(int argc, char **argv)
{
EXEC SQL BEGIN DECLARE SECTION;
	char *blob;
	char  *start_time;
EXEC SQL END DECLARE SECTION;

	if (--argc != 2)
		jmscott_die_argc(EXIT_BAD, argc, 2, usage);
	close(0);
	close(1);

	jmscott_ecpg_error_code = jmscott_ecpg_warn_code = 1;

	//  frisk the blob udig from argv[1]

        blob = argv[1];
        char *err;
        if ((err = jmscott_frisk_udig(blob)))
                die2("can not parse udig", blob);
	
	start_time = argv[2];
	if (!start_time[0])
		die("empty start time");

	EXEC SQL WHENEVER SQLERROR CALL jmscott_ecpg_error(
                (struct jmscott_ecpg_state_fault *)0
        );

        EXEC SQL CONNECT TO default;

	EXEC SQL SET search_path TO blobio;
	EXEC SQL INSERT INTO
		brr_discover(blob, start_time)
		VALUES(:blob, :start_time::brr_timestamp)
	  ON CONFLICT (blob) DO UPDATE 
	    SET
	    	start_time = :start_time::brr_timestamp
	    WHERE
	    	EXCLUDED.start_time > :start_time::brr_timestamp
	;
	EXEC SQL COMMIT;
}
